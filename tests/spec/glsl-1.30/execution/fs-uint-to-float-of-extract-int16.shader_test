# Intel compiler has a very old optimization for various combination
# of u2f or i2f of an extract_* source. However, the variations that
# do u2f of an extract_i* are incorrect.
#
# There are two ways the fast path could be incorrect. It could either
# emit
#
#    mov(8)   g1F, g2<4,1,0>W
#
# or it could emit
#
#    mov(8)   g1F, g2<4,1,0>UW
#
# The former produce -1.0 and the latter would produce 65535.0. The
# current incorrect implementation just happens to be the former, but
# the latter has equal probability of being implemented. I implemented
# the test so either of the possible incorrect fast path
# implementations would render blue, but any other kind of bug would
# render red.

[require]
GLSL >= 1.30

[vertex shader passthrough]

[fragment shader]
#version 130

uniform int a = 0x0000ffff;

void main()
{
   float f = float(uint((a << 16) >> 16));

   // The correct result is float(uint(0xffffffff)), i.e. float(4294967295u).
   // 4294967295 (2^32 - 1) is not exactly representable as a 32-bit float, so
   // per the GLSL conversion precision rules it may round to the nearest
   // representable value, 2^32 (4294967296.0), or toward zero to 2^32 - 256
   // (4294967040.0). Accept either valid result.
   if (f == 4294967296.0 || f == 4294967040.0) {
      gl_FragColor = vec4(0.0, 1.0, 0.0, 1.0);
   } else {
     gl_FragColor = (f == 65535.0 || f == -1.0)
	 ? vec4(0.0, 0.0, 1.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
   }
}

[test]
draw rect -1 -1 2 2
probe all rgba 0.0 1.0 0.0 1.0
