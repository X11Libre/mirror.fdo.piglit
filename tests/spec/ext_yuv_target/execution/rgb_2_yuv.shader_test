[require]
GL ES >= 3.0
GLSL ES >= 3.0

[vertex shader passthrough]

[fragment shader]
#version 300 es
#extension GL_EXT_YUV_target : require
precision highp float;

uniform int mode;
uniform vec3 rgb;
out vec4 color;

void main()
{
    yuvCscStandardEXT csc = itu_601;
    if (mode == 1)
        csc = itu_601_full_range;
    else if (mode == 2)
        csc = itu_709;
    color = vec4(rgb_2_yuv(rgb, csc), 1.0);
}

[test]

# Test BT.601 (narrow-range)
uniform int mode 0

uniform vec3 rgb 1.0 1.0 1.0
draw rect -1 -1 2 2
relative probe rgb (0.5, 0.5) (0.9215686274509803, 0.5019607843137255, 0.5019607843137255)

uniform vec3 rgb 0.0 0.0 0.0
draw rect -1 -1 2 2
relative probe rgb (0.5, 0.5) (0.06274509803921569, 0.5019607843137255, 0.5019607843137255)

uniform vec3 rgb 0.5 0.5 0.5
draw rect -1 -1 2 2
relative probe rgb (0.5, 0.5) (0.492156862745098, 0.5019607843137255, 0.5019607843137255)

uniform vec3 rgb 1.0 0.0 0.0
draw rect -1 -1 2 2
