draw rect -1 -1 2 2
relative probe rgb (0.5, 0.5) (0.16065098039215686, 0.9411764705882353, 0.4305334116528209)

uniform vec3 rgb 1.0 1.0 0.0
draw rect -1 -1 2 2
relative probe rgb (0.5, 0.5) (0.8236627450980392, 0.06274509803921569, 0.5733881569746301)

uniform vec3 rgb 0.0 1.0 1.0
draw rect -1 -1 2 2
relative probe rgb (0.5, 0.5) (0.6647803921568628, 0.6501836852122338, 0.06274509803921569)

uniform vec3 rgb 1.0 0.0 1.0
draw rect -1 -1 2 2
relative probe rgb (0.5, 0.5) (0.4174392156862745, 0.7929535696897269, 0.8697490979273306)

# Test BT.601 full-range
uniform int mode 1

uniform vec3 rgb 1.0 1.0 1.0
draw rect -1 -1 2 2
relative probe rgb (0.5, 0.5) (1.0, 0.5019607843137255, 0.5019607843137255)

uniform vec3 rgb 0.0 0.0 0.0
draw rect -1 -1 2 2
relative probe rgb (0.5, 0.5) (0.0, 0.5019607843137255, 0.5019607843137255)

# Test BT.709
uniform int mode 2

uniform vec3 rgb 1.0 0.0 0.0
draw rect -1 -1 2 2
relative probe rgb (0.5, 0.5) (0.24533098039215687, 0.4013170519339445, 0.9411764705882353)

