/* Checks if a shader with a buffer variable accessed with a swizzle
 * links successfully. This tests a regression in Mesa.
 */

[require]
GLSL >= 1.20
GL_ARB_shader_storage_buffer_object
INT GL_MAX_VERTEX_SHADER_STORAGE_BLOCKS >= 1

[vertex shader]

#version 120
#extension GL_ARB_shader_storage_buffer_object: require

buffer bufblock {
  ivec4 iface_var;
};

void main()
{
  atomicMin(iface_var.x, 2);
  gl_Position = vec4(0.0);
}

[test]
link success
